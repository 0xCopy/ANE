# anebridge.def — Kotlin/Native cinterop definition for libanebridge
# Maps the C ANEBridge.h API into Kotlin/Native types

package = dev.ane.cinterop
headers = ANEBridge.h
headerFilter = ANEBridge.h

compilerOpts = -Iobjc-bridge
linkerOpts = -Lbuild -lanebridge -framework Foundation -framework IOSurface -framework Accelerate -ldl -lobjc

# Static library mode (paths are relative to project root, not .def file)
staticLibraries = libanebridge.a
libraryPaths = build
