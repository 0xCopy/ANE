// The `ane` dialect: the MIL operations this repo sends to the Apple Neural Engine, one MLIR op per MIL op.
//
// Declared in IRDL, so the stock tools load it with no C++:  mlir-opt --irdl-file=ane.irdl.mlir file.mlir
// What IRDL checks: operand and result counts, that they are tensors, attribute names and kinds, and the type
// equalities noted per op.  What it cannot check (shapes, element types inside a tensor, device limits) is in the
// comments and is checked by running: tools/ane_dialect.py to-mil prints a module of these ops as MIL for the device,
// and the same MIL goes through tools/mil2mlir.py to linalg for the CPU (NEON through LLVM).
//
// A kernel is a func.func of ane ops.  Attributes hold what MIL writes as `const` statements of int, bool, string
// and shape type.  Operand order is fixed (MIL passes arguments by name; the names are in each op below).
// An optional operand may be absent; when an op has two or more optional or variadic operands, the attribute
// `operandSegmentSizes = array<i32: ...>` gives the size of each group, in declaration order.  Variadic operands and
// results share one type in IRDL, so they are passed and returned as tensor<*xT> (tensor.cast).  Attributes the
// declaration does not list are optional in MIL and are checked only by the round trip.
//
// Generated by `tools/ane_dialect.py irdl`; edit the table there.

irdl.dialect @ane {
  // A scalar constant (float or integer), as a rank-0 tensor.  MIL: `fp16 n = const()[val = fp16(v)]`; the attribute's type
  // is the MIL type (f16, f32, i32, i8, ui32, ...).
  irdl.operation @const {
    %vf = irdl.base "#builtin.float"
    %vi = irdl.base "#builtin.integer"
    %v = irdl.any_of(%vf, %vi)
    %r = irdl.base "!builtin.tensor"
    irdl.attributes { "value" = %v }
    irdl.results(r: %r)
  }

  // A small tensor constant written inline in the MIL text (a lookup table, ...): `dense<[...]> : tensor<..>`.  IRDL has no
  // constraint for dense attributes except `any`; the round trip checks the rest.
  irdl.operation @dense {
    %v = irdl.any
    %r = irdl.base "!builtin.tensor"
    irdl.attributes { "value" = %v }
    irdl.results(r: %r)
  }

  // Constant data in a weight file.  MIL: `const()[val = tensor<..>(BLOBFILE(path, offset))]`.
  // `offset` is the byte offset of the chunk header.  The device reads the data from the absolute data offset in the chunk
  // header (at +16).  Measured on M3 Pro: with 0 there, macOS 15.8.3 reported InvalidMILProgram (the benches' header, which
  // also lacks the payload size), and macOS 27.2.1 compiles and evaluates on the wrong bytes.  The payload size (at +8) is
  // not checked on 27.2.1: any value, 0 included.
  irdl.operation @blob {
    %p = irdl.base "#builtin.string"
    %o = irdl.base "#builtin.integer"
    %r = irdl.base "!builtin.tensor"
    irdl.attributes { "path" = %p, "offset" = %o }
    irdl.results(r: %r)
  }

  // int8 weights dequantized at compile time: (q - zero_point) * scale; the blob has the result's shape.
  // macOS 27.2.1, M3 Pro: compiles, and runs at fp16 speed, with the parameters in the [...] attribute list (how
  // ane_int8_bench.m and to-mil write it; int8 with zero_point 0 and 3, uint8 with 128); with the parameters as call
  // arguments it fails with InvalidMILProgram.  The 15.8.3 note "the compiler rejects this op" was measured with the argument
  // form only.  ane.blob (int8) + ane.cast + ane.mul also compiles, but runs 5.7x (256 channels) to 20x (384, 512) slower than
  // the fp16 conv on 27.2.1 (5.1-5.4x at every size on 15.8.3); constexpr_affine_dequantize runs at 0.97-1.13x of fp16.
  irdl.operation @constexpr_affine_dequantize {
    %p = irdl.base "#builtin.string"
    %o = irdl.base "#builtin.integer"
    %a = irdl.base "#builtin.integer"
    %z = irdl.base "#builtin.integer"
    %s = irdl.base "#builtin.float"
    %r = irdl.base "!builtin.tensor"
    irdl.attributes { "path" = %p, "offset" = %o, "axis" = %a, "zero_point" = %z, "scale" = %s }
    irdl.results(r: %r)
  }

  // The same MIL op in general form: the quantized data (int8 or uint8, an ane.blob), the scale and the zero point (an ane.blob
  // per channel, or an ane.const for one value) are operands, `axis` says which dimension the per-channel tensors run along.
  // The attribute form above is the int8, per-tensor case with the blob folded in.  Both write the MIL the device accepts
  // (parameters in the [...] list).  Measured on 27.2.1: axis = 0 compiles and matches the CPU (per-channel or per-tensor scale,
  // zero point 0, 5 or 128); axis = 1 is refused, also with a per-tensor scale.
  irdl.operation @affine_dequantize {
    %t0 = irdl.base "!builtin.tensor"
    %t1 = irdl.base "!builtin.tensor"
    %t2 = irdl.base "!builtin.tensor"
    %a = irdl.base "#builtin.integer"
    %r = irdl.base "!builtin.tensor"
    irdl.operands(quantized_data: %t0, scale: %t1, zero_point: %t2)
    irdl.attributes { "axis" = %a }
    irdl.results(r: %r)
  }

  // elementwise, numpy broadcast; a scalar operand is an ane.const
  irdl.operation @mul {
    %t0 = irdl.base "!builtin.tensor"
    %t1 = irdl.base "!builtin.tensor"
    %r = irdl.base "!builtin.tensor"
    irdl.operands(x: %t0, y: %t1)
    irdl.results(r: %r)
  }

  // elementwise, numpy broadcast
  irdl.operation @add {
    %t0 = irdl.base "!builtin.tensor"
    %t1 = irdl.base "!builtin.tensor"
    %r = irdl.base "!builtin.tensor"
    irdl.operands(x: %t0, y: %t1)
    irdl.results(r: %r)
  }

  // elementwise, numpy broadcast
  irdl.operation @sub {
    %t0 = irdl.base "!builtin.tensor"
    %t1 = irdl.base "!builtin.tensor"
    %r = irdl.base "!builtin.tensor"
    irdl.operands(x: %t0, y: %t1)
    irdl.results(r: %r)
  }

  // elementwise x^y, numpy broadcast
  irdl.operation @pow {
    %t0 = irdl.base "!builtin.tensor"
    %t1 = irdl.base "!builtin.tensor"
    %r = irdl.base "!builtin.tensor"
    irdl.operands(x: %t0, y: %t1)
    irdl.results(r: %r)
  }

  // 1 / (1 + exp(-x)); result type = operand type
  irdl.operation @sigmoid {
    %r = irdl.base "!builtin.tensor"
    irdl.operands(x: %r)
    irdl.results(r: %r)
  }

  // along `axis`; result type = operand type
  irdl.operation @softmax {
    %r = irdl.base "!builtin.tensor"
    %a0 = irdl.base "#builtin.integer"
    irdl.operands(x: %r)
    irdl.attributes { "axis" = %a0 }
    irdl.results(r: %r)
  }

  // sum over `axes`
  irdl.operation @reduce_sum {
    %t0 = irdl.base "!builtin.tensor"
    %r = irdl.base "!builtin.tensor"
    %a0 = irdl.base "#builtin.array"
    %a1 = irdl.base "#builtin.integer"
    irdl.operands(x: %t0)
    irdl.attributes { "axes" = %a0, "keep_dims" = %a1 }
    irdl.results(r: %r)
  }

  // row-major; `shape` equals the result shape
  irdl.operation @reshape {
    %t0 = irdl.base "!builtin.tensor"
    %r = irdl.base "!builtin.tensor"
    %a0 = irdl.base "#builtin.array"
    irdl.operands(x: %t0)
    irdl.attributes { "shape" = %a0 }
    irdl.results(r: %r)
  }

  // result dim i = operand dim perm[i]
  irdl.operation @transpose {
    %t0 = irdl.base "!builtin.tensor"
    %r = irdl.base "!builtin.tensor"
    %a0 = irdl.base "#builtin.array"
    irdl.operands(x: %t0)
    irdl.attributes { "perm" = %a0 }
    irdl.results(r: %r)
  }

  // x[begin : begin + size]; how a dynamic kernel unpacks activations and weights from its one input
  irdl.operation @slice_by_size {
    %t0 = irdl.base "!builtin.tensor"
    %r = irdl.base "!builtin.tensor"
    %a0 = irdl.base "#builtin.array"
    %a1 = irdl.base "#builtin.array"
    irdl.operands(x: %t0)
    irdl.attributes { "begin" = %a0, "size" = %a1 }
    irdl.results(r: %r)
  }

  // along `axis`; how a kernel packs several outputs into its one output.
  // IRDL gives variadic operands one type, so each value is passed as tensor<*xT> (tensor.cast)
  irdl.operation @concat {
    %t0 = irdl.base "!builtin.unranked_tensor"
    %r = irdl.base "!builtin.tensor"
    %a0 = irdl.base "#builtin.integer"
    %a1 = irdl.base "#builtin.integer"
    irdl.operands(values: variadic %t0)
    irdl.attributes { "axis" = %a0, "interleave" = %a1 }
    irdl.results(r: %r)
  }

  // batched over the leading dims.  Device (M3 Pro, README "Device facts"): a contracted dim of 16384 compiles, 16385 does not
  irdl.operation @matmul {
    %t0 = irdl.base "!builtin.tensor"
    %t1 = irdl.base "!builtin.tensor"
    %r = irdl.base "!builtin.tensor"
    %a0 = irdl.base "#builtin.integer"
    %a1 = irdl.base "#builtin.integer"
    irdl.operands(x: %t0, y: %t1)
    irdl.attributes { "transpose_x" = %a0, "transpose_y" = %a1 }
    irdl.results(r: %r)
  }

  // NCHW x, OIHW weight.  Every use in the repo is 1x1, valid, groups 1: a linear map over channels.
  // Device (M3 Pro): 32000 input channels compile, 32512 is the most that do (macOS 27.2.1); 32000 -> 768 fails at SP 64, compiles at SP 256
  irdl.operation @conv {
    %t0 = irdl.base "!builtin.tensor"
    %t1 = irdl.base "!builtin.tensor"
    %t2 = irdl.base "!builtin.tensor"
    %r = irdl.base "!builtin.tensor"
    %a0 = irdl.base "#builtin.array"
    %a1 = irdl.base "#builtin.array"
    %a2 = irdl.base "#builtin.array"
    %a3 = irdl.base "#builtin.string"
    %a4 = irdl.base "#builtin.integer"
    irdl.operands(x: %t0, weight: %t1, bias: optional %t2)
    irdl.attributes { "strides" = %a0, "dilations" = %a1, "pad" = %a2, "pad_type" = %a3, "groups" = %a4 }
    irdl.results(r: %r)
  }

  // fp32 <-> fp16; fp32 -> fp16 rounds to nearest even and overflows to inf at 65520
  irdl.operation @cast {
    %t0 = irdl.base "!builtin.tensor"
    %r = irdl.base "!builtin.tensor"
    %a0 = irdl.base "#builtin.string"
    irdl.operands(x: %t0)
    irdl.attributes { "dtype" = %a0 }
    irdl.results(r: %r)
  }

  // input * fp16(1 / scale), rounded half away from zero, saturated to [-128, 127]  (device, macOS 27.2.1: README "Sharp corners")
  irdl.operation @quantize {
    %t0 = irdl.base "!builtin.tensor"
    %t1 = irdl.base "!builtin.tensor"
    %t2 = irdl.base "!builtin.tensor"
    %r = irdl.base "!builtin.tensor"
    %a0 = irdl.base "#builtin.string"
    irdl.operands(input: %t0, scale: %t1, zero_point: optional %t2)
    irdl.attributes { "output_dtype" = %a0 }
    irdl.results(r: %r)
  }

  // int8 * scale, the product rounded to fp16 with ties away from zero (device, macOS 27.2.1)
  irdl.operation @dequantize {
    %t0 = irdl.base "!builtin.tensor"
    %t1 = irdl.base "!builtin.tensor"
    %t2 = irdl.base "!builtin.tensor"
    %r = irdl.base "!builtin.tensor"
    irdl.operands(input: %t0, scale: %t1, zero_point: optional %t2)
    irdl.results(r: %r)
  }

  // ---- generated from ops/ane_ops.json: the MIL ops that compiled and ran correctly on the device ----

  // supported on the M3 Pro, macOS 27.2.1: 6 ok, 0 wrong, 0 refused programs in tools/ane_ops.py
  irdl.operation @abs {
    %t0 = irdl.base "!builtin.tensor"
    %r = irdl.base "!builtin.tensor"
    irdl.operands(x: %t0)
    irdl.results(r: %r)
  }

  // sensitive on the M3 Pro, macOS 27.2.1: 10 ok, 0 wrong, 9 refused programs in tools/ane_ops.py; refused in lg_argmax_w, lg_argmax_w_f16out, lg_argmin_c, lg_argsort_cast16
  irdl.operation @argsort {
    %t0 = irdl.base "!builtin.tensor"
    %r = irdl.base "!builtin.tensor"
    %a0 = irdl.base "#builtin.integer"
    %a1 = irdl.base "#builtin.integer"
    irdl.operands(x: %t0)
    irdl.attributes { "ascending" = %a0, "axis" = %a1 }
    irdl.results(r: %r)
  }

  // supported on the M3 Pro, macOS 27.2.1: 4 ok, 0 wrong, 0 refused programs in tools/ane_ops.py
  irdl.operation @atan {
    %t0 = irdl.base "!builtin.tensor"
    %r = irdl.base "!builtin.tensor"
    irdl.operands(x: %t0)
    irdl.results(r: %r)
  }

  // supported on the M3 Pro, macOS 27.2.1: 6 ok, 0 wrong, 0 refused programs in tools/ane_ops.py
  irdl.operation @avg_pool {
    %t0 = irdl.base "!builtin.tensor"
    %r = irdl.base "!builtin.tensor"
    %a0 = irdl.base "#builtin.integer"
    %a1 = irdl.base "#builtin.integer"
    %a2 = irdl.base "#builtin.array"
    %a3 = irdl.base "#builtin.array"
    %a4 = irdl.base "#builtin.string"
    %a5 = irdl.base "#builtin.array"
    irdl.operands(x: %t0)
    irdl.attributes { "ceil_mode" = %a0, "exclude_padding_from_average" = %a1, "kernel_sizes" = %a2, "pad" = %a3, "pad_type" = %a4, "strides" = %a5 }
    irdl.results(r: %r)
  }

  // supported on the M3 Pro, macOS 27.2.1: 1 ok, 0 wrong, 0 refused programs in tools/ane_ops.py
  irdl.operation @batch_norm {
    %t0 = irdl.base "!builtin.tensor"
    %t1 = irdl.base "!builtin.tensor"
    %t2 = irdl.base "!builtin.tensor"
    %t3 = irdl.base "!builtin.tensor"
    %t4 = irdl.base "!builtin.tensor"
    %r = irdl.base "!builtin.tensor"
    %a0 = irdl.base "#builtin.float"
    irdl.operands(x: %t0, beta: %t1, gamma: %t2, mean: %t3, variance: %t4)
    irdl.attributes { "epsilon" = %a0 }
    irdl.results(r: %r)
  }

  // supported on the M3 Pro, macOS 27.2.1: 1 ok, 0 wrong, 0 refused programs in tools/ane_ops.py
  irdl.operation @batch_to_space {
    %t0 = irdl.base "!builtin.tensor"
    %r = irdl.base "!builtin.tensor"
    %a0 = irdl.base "#builtin.array"
    %a1 = irdl.base "#builtin.array"
    irdl.operands(x: %t0)
    irdl.attributes { "block_shape" = %a0, "crops" = %a1 }
    irdl.results(r: %r)
  }

  // supported on the M3 Pro, macOS 27.2.1: 5 ok, 0 wrong, 0 refused programs in tools/ane_ops.py
  irdl.operation @ceil {
    %t0 = irdl.base "!builtin.tensor"
    %r = irdl.base "!builtin.tensor"
    irdl.operands(x: %t0)
    irdl.results(r: %r)
  }

  // supported on the M3 Pro, macOS 27.2.1: 1 ok, 0 wrong, 0 refused programs in tools/ane_ops.py
  irdl.operation @clamped_relu {
    %t0 = irdl.base "!builtin.tensor"
    %r = irdl.base "!builtin.tensor"
    %a0 = irdl.base "#builtin.float"
    %a1 = irdl.base "#builtin.float"
    irdl.operands(x: %t0)
    irdl.attributes { "alpha" = %a0, "beta" = %a1 }
    irdl.results(r: %r)
  }

  // supported on the M3 Pro, macOS 27.2.1: 1 ok, 0 wrong, 0 refused programs in tools/ane_ops.py
  irdl.operation @clip {
    %t0 = irdl.base "!builtin.tensor"
    %r = irdl.base "!builtin.tensor"
    %a0 = irdl.base "#builtin.float"
    %a1 = irdl.base "#builtin.float"
    irdl.operands(x: %t0)
    irdl.attributes { "alpha" = %a0, "beta" = %a1 }
    irdl.results(r: %r)
  }

  // sensitive on the M3 Pro, macOS 27.2.1: 2 ok, 0 wrong, 9 refused programs in tools/ane_ops.py; refused in wq_blockwise_i4_b32, wq_blockwise_i8_b16, wq_blockwise_i8_b32, wq_blockwise_i8_b32_axis0
  irdl.operation @constexpr_blockwise_shift_scale {
    %t0 = irdl.base "!builtin.tensor"
    %t1 = irdl.base "!builtin.tensor"
    %t2 = irdl.base "!builtin.tensor"
    %r = irdl.base "!builtin.tensor"
    irdl.operands(data: %t0, scale: %t1, offset: optional %t2)
    irdl.results(r: %r)
  }

  // supported on the M3 Pro, macOS 27.2.1: 9 ok, 0 wrong, 0 refused programs in tools/ane_ops.py
  irdl.operation @constexpr_lut_to_dense {
    %t0 = irdl.base "!builtin.tensor"
    %t1 = irdl.base "!builtin.tensor"
    %r = irdl.base "!builtin.tensor"
    irdl.operands(indices: %t0, lut: %t1)
    irdl.results(r: %r)
  }

  // supported on the M3 Pro, macOS 27.2.1: 3 ok, 0 wrong, 0 refused programs in tools/ane_ops.py
  irdl.operation @constexpr_sparse_to_dense {
    %t0 = irdl.base "!builtin.tensor"
    %t1 = irdl.base "!builtin.tensor"
    %r = irdl.base "!builtin.tensor"
    irdl.operands(mask: %t0, nonzero_data: %t1)
    irdl.results(r: %r)
  }

  // supported on the M3 Pro, macOS 27.2.1: 6 ok, 0 wrong, 0 refused programs in tools/ane_ops.py
  irdl.operation @conv_transpose {
    %t0 = irdl.base "!builtin.tensor"
    %t1 = irdl.base "!builtin.tensor"
    %t2 = irdl.base "!builtin.tensor"
    %r = irdl.base "!builtin.tensor"
    %a0 = irdl.base "#builtin.array"
    %a1 = irdl.base "#builtin.integer"
    %a2 = irdl.base "#builtin.array"
    %a3 = irdl.base "#builtin.string"
    %a4 = irdl.base "#builtin.array"
    irdl.operands(x: %t0, weight: %t1, bias: optional %t2)
    irdl.attributes { "dilations" = %a0, "groups" = %a1, "pad" = %a2, "pad_type" = %a3, "strides" = %a4 }
    irdl.results(r: %r)
  }

  // supported on the M3 Pro, macOS 27.2.1: 5 ok, 0 wrong, 0 refused programs in tools/ane_ops.py
  irdl.operation @cos {
    %t0 = irdl.base "!builtin.tensor"
    %r = irdl.base "!builtin.tensor"
    irdl.operands(x: %t0)
    irdl.results(r: %r)
  }

  // supported on the M3 Pro, macOS 27.2.1: 2 ok, 0 wrong, 0 refused programs in tools/ane_ops.py
  irdl.operation @crop {
    %t0 = irdl.base "!builtin.tensor"
    %r = irdl.base "!builtin.tensor"
    %a0 = irdl.base "#builtin.array"
    %a1 = irdl.base "#builtin.array"
    irdl.operands(x: %t0)
    irdl.attributes { "crop_height" = %a0, "crop_width" = %a1 }
    irdl.results(r: %r)
  }

  // supported on the M3 Pro, macOS 27.2.1: 1 ok, 0 wrong, 0 refused programs in tools/ane_ops.py
  irdl.operation @depth_to_space {
    %t0 = irdl.base "!builtin.tensor"
    %r = irdl.base "!builtin.tensor"
    %a0 = irdl.base "#builtin.integer"
    irdl.operands(x: %t0)
    irdl.attributes { "block_size" = %a0 }
    irdl.results(r: %r)
  }

  // supported on the M3 Pro, macOS 27.2.1: 1 ok, 0 wrong, 0 refused programs in tools/ane_ops.py
  irdl.operation @einsum {
    %t0 = irdl.base "!builtin.unranked_tensor"
    %r = irdl.base "!builtin.tensor"
    %a0 = irdl.base "#builtin.string"
    irdl.operands(values: variadic %t0)
    irdl.attributes { "equation" = %a0 }
    irdl.results(r: %r)
  }

  // supported on the M3 Pro, macOS 27.2.1: 1 ok, 0 wrong, 0 refused programs in tools/ane_ops.py
  irdl.operation @elu {
    %t0 = irdl.base "!builtin.tensor"
    %r = irdl.base "!builtin.tensor"
    %a0 = irdl.base "#builtin.float"
    irdl.operands(x: %t0)
    irdl.attributes { "alpha" = %a0 }
    irdl.results(r: %r)
  }

  // sensitive on the M3 Pro, macOS 27.2.1: 105 ok, 0 wrong, 7 refused programs in tools/ane_ops.py; refused in lg_dead_chain3, lg_dead_equal, lg_dead_equal_cast, lg_topk_val_w4
  irdl.operation @equal {
    %t0 = irdl.base "!builtin.tensor"
    %t1 = irdl.base "!builtin.tensor"
    %r = irdl.base "!builtin.tensor"
    irdl.operands(x: %t0, y: %t1)
    irdl.results(r: %r)
  }

  // supported on the M3 Pro, macOS 27.2.1: 2 ok, 0 wrong, 0 refused programs in tools/ane_ops.py
  irdl.operation @erf {
    %t0 = irdl.base "!builtin.tensor"
    %r = irdl.base "!builtin.tensor"
    irdl.operands(x: %t0)
    irdl.results(r: %r)
  }

  // supported on the M3 Pro, macOS 27.2.1: 18 ok, 0 wrong, 0 refused programs in tools/ane_ops.py
  irdl.operation @exp {
    %t0 = irdl.base "!builtin.tensor"
    %r = irdl.base "!builtin.tensor"
    irdl.operands(x: %t0)
    irdl.results(r: %r)
  }

  // supported on the M3 Pro, macOS 27.2.1: 1 ok, 0 wrong, 0 refused programs in tools/ane_ops.py
  irdl.operation @exp2 {
    %t0 = irdl.base "!builtin.tensor"
    %r = irdl.base "!builtin.tensor"
    irdl.operands(x: %t0)
    irdl.results(r: %r)
  }

  // supported on the M3 Pro, macOS 27.2.1: 5 ok, 0 wrong, 0 refused programs in tools/ane_ops.py
  irdl.operation @expand_dims {
    %t0 = irdl.base "!builtin.tensor"
    %r = irdl.base "!builtin.tensor"
